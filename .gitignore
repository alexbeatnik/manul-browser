# Repo-wide ignores. core/ keeps its own .gitignore for Go build output.

# OS junk
.DS_Store
Thumbs.db

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*~

# Run output. The engine writes reports/ into whatever directory it is invoked
# from, so driving a hunt from a binding leaves one there too — core/ already
# ignores its own copy.
reports/

# Release artifacts (goreleaser + binding packaging)
/dist/
/bindings/*/dist/
/bindings/*/build/
/bindings/**/vendor/manul
/bindings/**/vendor/manul.exe

# The engine binary the release job stages inside the Python package. Never
# committed; `artifacts` in pyproject.toml is what puts it into the wheel.
/bindings/python/manul/_bin/

# Python binding
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# Node binding
node_modules/

# Conformance run output
/conformance/actual/

# Test output
screenshots/
